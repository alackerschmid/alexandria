{
  "name": "bookscan",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "dev:worker": "cd worker && npm run dev",
    "deploy:worker": "cd worker && npm run deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "@ericblade/quagga2": "^1.12.1",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/overpass-mono": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/roboto-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@mdi/font": "7.4.47",
    "papaparse": "^5.5.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.30",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.3",
    "vuetify": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^24.12.0",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^9.39.4",
    "eslint-config-vuetify": "^4.3.4",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "^1.98.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "unplugin-fonts": "^1.4.0",
    "vite": "^8.0.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.2.5"
  },
  "overrides": {
    "unplugin-fonts": {
      "vite": "^8.0.0"
    },
    "@eslint/js": "^9.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "sharp@0.34.5": true
  }
}
