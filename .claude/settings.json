{
  "permissions": {
    "allow": [
      "mcp__plugin_cloudflare_cloudflare-docs__search_cloudflare_documentation",
      "mcp__plugin_cloudflare_cloudflare-docs__migrate_pages_to_workers_guide",
      "mcp__plugin_cloudflare_cloudflare-observability__query_worker_observability",
      "mcp__plugin_cloudflare_cloudflare-observability__observability_keys",
      "mcp__plugin_cloudflare_cloudflare-observability__observability_values",
      "mcp__plugin_cloudflare_cloudflare-observability__workers_list",
      "mcp__plugin_cloudflare_cloudflare-observability__workers_get_worker",
      "mcp__plugin_cloudflare_cloudflare-bindings__d1_databases_list",
      "mcp__plugin_cloudflare_cloudflare-bindings__d1_database_get",
      "mcp__plugin_cloudflare_cloudflare-builds__workers_builds_list_builds",
      "mcp__plugin_cloudflare_cloudflare-builds__workers_builds_get_build",
      "mcp__plugin_cloudflare_cloudflare-builds__workers_builds_get_build_logs",
      "WebFetch(domain:developers.cloudflare.com)",
      "PowerShell(npm run type-check 2>&1 | Select-Object -Last 6; Write-Output \"---- worker ----\"; npx --prefix worker tsc -p worker/tsconfig.json --noEmit 2>&1 | Select-Object -First 20; Write-Output \"worker exit: $LASTEXITCODE\")"
    ],
    "deny": [
      "Read(/to-do.md)",
      "Edit(/to-do.md)",
      "Bash(npx wrangler deploy*)",
      "Bash(wrangler deploy*)",
      "Bash(npx wrangler pages deploy*)",
      "Bash(npx wrangler d1 execute * --remote*)",
      "Bash(npx wrangler d1 execute --remote*)",
      "Bash(wrangler d1 execute * --remote*)",
      "Bash(wrangler d1 execute --remote*)",
      "Bash(npx wrangler d1 migrations apply * --remote*)",
      "Bash(npm run deploy*)",
      "PowerShell(npx wrangler deploy*)",
      "PowerShell(wrangler deploy*)",
      "PowerShell(npx wrangler pages deploy*)",
      "PowerShell(npx wrangler d1 execute * --remote*)",
      "PowerShell(npx wrangler d1 execute --remote*)",
      "PowerShell(wrangler d1 execute * --remote*)",
      "PowerShell(wrangler d1 execute --remote*)",
      "PowerShell(npx wrangler d1 migrations apply * --remote*)",
      "PowerShell(npm run deploy*)",
      "mcp__plugin_cloudflare_cloudflare-bindings__d1_database_delete",
      "mcp__plugin_cloudflare_cloudflare-bindings__kv_namespace_delete",
      "mcp__plugin_cloudflare_cloudflare-bindings__r2_bucket_delete",
      "mcp__plugin_cloudflare_cloudflare-bindings__hyperdrive_config_delete",
      "mcp__plugin_cloudflare_cloudflare-api__execute"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/record-edit.mjs"],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/verify.mjs"],
            "timeout": 300,
            "statusMessage": "Verifying edited files..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-commit.mjs"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
